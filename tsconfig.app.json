{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    
    /* 🚀 CAMBIO: "bundler" es el estándar para Vite y resuelve mejor las librerías */
    "moduleResolution": "bundler", 
    "allowImportingTsExtensions": true,
    
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,

    /* 🚀 FUNDAMENTAL: Esto le dice a TS dónde buscar el "manual" de Node */
    "types": ["node"] 
  },
  "include": ["src"]
}